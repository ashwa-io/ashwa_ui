{
  "name": "@ashwa-io/ui",
  "version": "0.0.7",
  "description": "Ashwa design system: locked React components on shadcn/ui (Base UI) and Tailwind v4, with per-org brand theming.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashwa-io/ashwa_ui.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "yarn@4.7.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsdown",
    "check:dist": "node scripts/check-dist.mjs",
    "prepublishOnly": "yarn build && yarn check:dist",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.21",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@changesets/cli": "^3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^8.21",
    "@types/culori": "^4.0.1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.14.0",
    "lucide-react": "^1.70.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.6",
    "tailwindcss": "^4",
    "tsdown": "^0.23.7",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1",
    "vite": "^8",
    "vitest": "^5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "culori": "^4.0.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  }
}
